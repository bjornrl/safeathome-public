NEXT_PUBLIC_SUPABASE_URL=https://ditsssyrzjqdnhqxnffx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Dev-mode public lock. When set to "1", anonymous visitors can only reach
# `/`, `/login*`, `/auth` and `/auth/*`; every other route redirects to
# `/login?redirect=<path>`. Leave unset (or "0") to disable.
# Note: `/admin*` and `/internal*` always require a session regardless of
# this flag — the lock only gates the remaining routes. See src/proxy.ts.
NEXT_PUBLIC_DEV_LOCK=1

# --- OTP-innlogging ---------------------------------------------------
# Login uses e-mail one-time codes. No env var controls it, but it does
# depend on manual Supabase dashboard settings (e-mail template must emit
# {{ .Token }}, not {{ .ConfirmationURL }}). See docs/otp-drift.md.

# Server-only. Powers the "✦ Suggest" button on Quick Notes (Claude Haiku).
# Must also be set in Netlify env for production. When unset, the button
# is hidden entirely (no client-visible failure).
ANTHROPIC_API_KEY=sk-ant-...

# Server-only. Powers semantic search & embeddings (ADR 0001).
# Must also be set in Netlify env for production. When unset, embedding is
# skipped and /internal/search degrades to keyword-only — no client failure.
OPENAI_API_KEY=sk-...

# Server-only, OPS ONLY (never shipped to the client / Netlify functions).
# Used by scripts/backfill-embeddings.mjs to bypass RLS and re-embed all rows.
# Find it in Supabase → Project Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=ey...

# ── Kontaktwidget ────────────────────────────────────────────────────────
# Server-only. Sender e-postvarsel når en besøkende bruker meldingsboblen.
# Må også settes i Netlify env for produksjon. Når de mangler lagres meldingen
# fortsatt i public.contact_messages — bare varselet uteblir (notified_at
# forblir NULL), så ingenting går tapt.
RESEND_API_KEY=re_...

# Adressen varslene går til.
CONTACT_TO_EMAIL=navn@eksempel.no

# Valgfri. Uten denne brukes Resend sin delte avsender, som ikke krever DNS,
# men bare leverer til eieren av Resend-kontoen. Sett din egen når domenet er
# verifisert i Resend, f.eks. "safe@home <kontakt@dittdomene.no>".
CONTACT_FROM_EMAIL=

# Valgfri, men anbefalt i produksjon. Salt for hashing av IP-adresser til
# døgnkvoten. Vilkårlig lang tilfeldig streng — adressene lagres aldri i klartekst.
CONTACT_IP_SALT=
